<core:ShellWindow x:Class="BetterDesktop.Shell.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:BetterDesktop.Shell.Core.Surface;assembly=BetterDesktop.Shell.Core"
    xmlns:surface="clr-namespace:BetterDesktop.Shell.Settings.Surface"
    Title="BetterDesktop 设置"
    Width="900" Height="640" MinWidth="760" MinHeight="520"
    FontFamily="Segoe UI, Microsoft YaHei, PingFang SC, sans-serif"
    WindowStartupLocation="CenterScreen">

    <core:ShellWindow.Resources>
        <!-- 关闭按钮圆点色（macOS 红绿灯） -->
        <SolidColorBrush x:Key="TrafficCloseFill" Color="#FFFF5F57" />

        <!-- 分区标题 → 矢量图标（ISettingsSection.IconKey 所有实现均为 null，故按标题映射） -->
        <surface:SectionIconConverter x:Key="SectionIconConverter" />

        <!-- 导航项模板：矢量图标 + 标题。
             图标描边与文字色都绑定到 ListBoxItem 的 Foreground，选中/悬停时随容器统一变化，
             不需要在模板里重复写一遍状态判断。 -->
        <DataTemplate x:Key="SectionItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="17" Height="17" Stretch="Uniform"
                      Data="{Binding Title, Converter={StaticResource SectionIconConverter}}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                      StrokeThickness="1.6" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                           VerticalAlignment="Center" Margin="7,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- 导航项容器样式：
             - 悬停：中性高亮（弱反馈）
             - 选中：强调色淡染 + 加粗（强反馈，且与"当前所在页面"语义一致）
             - 键盘聚焦：强调色描边环（可达性：状态不靠 hover 单独表达）
             三档反馈强度递进，不与彼此冲突。 -->
        <Style x:Key="SectionItemStyle" TargetType="ListBoxItem">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="Bd" CornerRadius="7" Margin="6,1" Background="Transparent" />
                            <Border x:Name="Wash" CornerRadius="7" Margin="6,1" IsHitTestVisible="False"
                                    Background="{DynamicResource SkinAccentFromSkin}" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="7" Margin="6,1" IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource SkinAccentFromSkin}"
                                    BorderThickness="1.6" Opacity="0" />
                            <ContentPresenter Margin="16,8,12,8" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.22" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </core:ShellWindow.Resources>

    <!-- 根 Border：与 AppGrabber 一致——背景跟随皮肤（SkinBackgroundBrush，与描边同一 DynamicResource 机制，
         一处改、全局窗口自动跟随），无皮肤时为半透明托盘，透出基类毛玻璃；极简视觉树。
         对齐统一基类/FrostedGlassDemo：显式声明圆角 8 + 1.5px 描边（受光面对角渐变，随主题刷新）。 -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource SkinBackgroundBrush}"
            Padding="0"
            CornerRadius="8"
            BorderThickness="1.5"
            BorderBrush="{DynamicResource CardBorderBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（托盘，颜色由主题令牌统一驱动，跟随外观模式，零代码补色） -->
            <Border x:Name="SideBorder" Grid.Column="0"
                    Background="{DynamicResource ThemePanelBackground}"
                    BorderBrush="{DynamicResource ThemeSeparator}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="20,20,18,14">
                        <TextBlock x:Name="HeaderTitle" Text="设置" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForeground}" />
                        <TextBlock x:Name="HeaderSubtitle" Text="BetterDesktop" FontSize="11.5" Margin="0,2,0,0"
                                   Foreground="{DynamicResource ThemeMutedForeground}" />
                    </StackPanel>
                    <ListBox x:Name="SectionList" DockPanel.Dock="Top"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource SectionItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="6,2,10,10"
                             SelectionChanged="OnSectionSelectionChanged" />
                </DockPanel>
            </Border>

            <!-- 右侧内容区：所有分区一次性构建，用 Visibility 切换（不重建视觉树，避免卡顿） -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 页面标题栏：唯一的页面级标题（各分区内重复的大标题已移除），同时是拖拽区。 -->
                <Border Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        BorderBrush="{DynamicResource ThemeSeparator}" BorderThickness="0,0,0,1">
                    <Grid Height="52">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TitleText" Text=""
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForeground}"
                                   VerticalAlignment="Center" Margin="30,0,0,0" />
                        <Button Grid.Column="1" x:Name="CloseButton" Width="46" Height="34"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Cursor="Hand" ToolTip="关闭" Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse x:Name="dot" Width="12" Height="12"
                                                     Fill="{StaticResource TrafficCloseFill}" />
                                            <!-- 常态只留红点，悬停才浮出 ✕：既干净又保留可发现性 -->
                                            <Path x:Name="glyph" Opacity="0"
                                                  Data="M0,0 L6,6 M6,0 L0,6"
                                                  Stroke="#FF4A0A0A" StrokeThickness="1.3"
                                                  Width="6" Height="6" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="glyph" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="dot" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- 内容滚动区：所有分区容器平铺于此，按选中显隐 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ContentPanel" Orientation="Vertical" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</core:ShellWindow>
