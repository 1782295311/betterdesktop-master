<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterDesktop.Shell.Desktop</RootNamespace>
    <AssemblyName>BetterDesktop.Shell.Desktop</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.370" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\kernel\BetterDesktop.Kernel.csproj" />
    <ProjectReference Include="..\shell-core\BetterDesktop.Shell.Core.csproj" />
    <ProjectReference Include="..\shell-app-source\BetterDesktop.Shell.AppSource.csproj" />
    <!-- 底部避让：读 components.dock / components.wintaskbar / dock.* 计算图标网格底部预留。
         无环：shell-settings 仅依赖 kernel/kernel-hmr/shell-core，不反向引用 shell-desktop。 -->
    <ProjectReference Include="..\shell-settings\BetterDesktop.Shell.Settings.csproj" />
    <!-- 右键菜单：消费 IFileClassifier 与 MenuItemDef（中央 IMenuService 管线已退役，桌面自绘+原生分流）。 -->
    <ProjectReference Include="..\shell-context-menu\BetterDesktop.Shell.ContextMenu.csproj" />
    <!-- 转换挂点（2026-09-07）：桌面图标右键「转换为 ▸」消费 IConvertMenuService（shell-convert）。 -->
    <ProjectReference Include="..\shell-convert\BetterDesktop.Shell.Convert.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\BetterDesktop.Api.csproj" />
  </ItemGroup>
</Project>
