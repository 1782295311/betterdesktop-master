<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterDesktop.Shell.AppSource</RootNamespace>
    <AssemblyName>BetterDesktop.Shell.AppSource</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\kernel\BetterDesktop.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.370" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\BetterDesktop.Api.csproj" />
  </ItemGroup>
</Project>
