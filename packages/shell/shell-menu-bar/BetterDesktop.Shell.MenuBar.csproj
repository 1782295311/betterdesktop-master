<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterDesktop.Shell.MenuBar</RootNamespace>
    <AssemblyName>BetterDesktop.Shell.MenuBar</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- H1b ProcessAppInfo 行为/测量单测（shell-menu-bar-tests）需要访问 internal 静态缓存。 -->
    <InternalsVisibleTo Include="BetterDesktop.Shell.MenuBar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="ManagedShell" Version="0.0.370" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\kernel\BetterDesktop.Kernel.csproj" />
    <ProjectReference Include="..\shell-core\BetterDesktop.Shell.Core.csproj" />
    <ProjectReference Include="..\shell-status\BetterDesktop.Shell.Status.csproj" />
    <ProjectReference Include="..\shell-settings\BetterDesktop.Shell.Settings.csproj" />
    <!-- 左区「程序菜单」复用开始菜单插件的服务契约（IStartMenuService）。
         已确认无环：shell-start-menu 不反向引用 shell-menu-bar；服务未注册时菜单栏降级为不显示该入口。 -->
    <ProjectReference Include="..\shell-start-menu\BetterDesktop.Shell.StartMenu.csproj" />
    <!-- 搜索按钮复用 shell-search 的聚合搜索服务（IStartMenuSearchService，程序/设置/文件三类）。 -->
    <ProjectReference Include="..\shell-search\BetterDesktop.Shell.Search.csproj" />
    <!-- 搜索结果图标：IAppIconService（shell-app-source 统一图标入口，按 AppItem 提取真实图标）。 -->
    <ProjectReference Include="..\shell-app-source\BetterDesktop.Shell.AppSource.csproj" />
    <!-- 左区前台窗口标题：IWindowTrackerService（WinEvent 钩子 + GetWindowText 收口）。 -->
    <ProjectReference Include="..\shell-window-tracker\BetterDesktop.Shell.WindowTracker.csproj" />
    <!-- 左区文件夹工具条：IDesktopBrowser（自绘桌面浏览器契约，位置/下载/文档联动 + 文件操作）。 -->
    <ProjectReference Include="..\shell-desktop\BetterDesktop.Shell.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>

    <ProjectReference Include="..\shell-calendar\BetterDesktop.Shell.Calendar.csproj" />
    <ProjectReference Include="..\shell-pinning\BetterDesktop.Shell.Pinning.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\BetterDesktop.Api.csproj" />
  </ItemGroup>


  <ItemGroup>
    <!-- 2026-09-17：独立设置进程（BetterDesktop.Settings.exe）按「分区目录」直接 new 本包的分区实现，
         不再依赖插件 LoadAsync 注册（见 packages/shell/shell-settings-host/SectionCatalog.cs）。
         只放开可见性，不改变任何运行时行为。 -->
    <InternalsVisibleTo Include="BetterDesktop.Settings" />
  </ItemGroup>
</Project>
