<!-- BetterDesktop.Shell.Core — 共享外观字典（壳 + 独立设置进程 + 后续轻量外壳进程共用一份）
     【2026-09-17 抽取】原样内容来自 host/App.xaml：宿主的主题令牌兜底画刷 + macOS 风控件样式
     （MacToggle / MacCombo / MacButton / MacAccentButton / MacSlider）+ 描边/阴影/滚动条规范。
     为什么要抽：独立设置进程（BetterDesktop.Settings.exe）要显示同一套设置分区，若各自"复制一份样式"
     必然漂移（本仓已有"三处映射漂移"的教训）。宿主据此改为 MergedDictionaries 引用本文件。
     ⚠️ 引用方需用 pack URI：
        pack://application:,,,/BetterDesktop.Shell.Core;component/Surface/ShellTheme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <!-- 外观模式驱动的控件画刷（由 AppearanceService 在模式切换时实时写入 Application.Current.Resources）。
             macOS 风控件（Mac* 样式）一律引用这些 DynamicResource，使亮色/暗色/无色模式一键切换。 -->
        <SolidColorBrush x:Key="ControlForeground" Color="#FFECECEC" />
        <SolidColorBrush x:Key="ControlBackground" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="ControlBackgroundHover" Color="#FF48484A" />
        <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#FF343436" />
        <SolidColorBrush x:Key="ControlBorder" Color="#FF48484A" />
        <SolidColorBrush x:Key="ControlTrack" Color="#FF48484A" />
        <SolidColorBrush x:Key="PopupBackground" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="PopupBorder" Color="#FF48484A" />
        <SolidColorBrush x:Key="PopupItemHover" Color="#FF3A3A3C" />

        <!-- 主题令牌画笔（由 AppearanceService 按外观模式实时推送，供 XAML DynamicResource 引用）。
             使设置窗口等 XAML 直接绑定令牌、随模式一键切换，无需在代码里手写补色（消除"特例独行"）。 -->
        <SolidColorBrush x:Key="ThemeWindowBackground" Color="#1F1F22" />
        <SolidColorBrush x:Key="ThemePanelBackground" Color="#262629" />
        <SolidColorBrush x:Key="ThemeContentBackground" Color="#2A2A2E" />
        <SolidColorBrush x:Key="ThemeForeground" Color="#F2F2F2" />
        <SolidColorBrush x:Key="ThemeMutedForeground" Color="#C4C4C4" />
        <SolidColorBrush x:Key="ThemeSeparator" Color="#B0B0B0" Opacity="0.25" />

        <!-- 皮肤/描边扩散令牌初始兜底：AppearanceService 在 Initialize() 时会以相同键覆盖推送，
             此处仅作 XAML 解析期兜底，防止 Initialize 时序异常导致 DynamicResource 键缺失而黑屏崩溃。
             - CardBorderBrush：窗口根描边（随主题刷新；默认中性半透明白，对齐 dock 描边基准）
             - CardShadowEffect：卡片外边缘阴影（默认 null = 无阴影，与当前"暂停外投影"一致）
             - BackgroundBrush / SkinBackgroundBrush：窗口根背景画刷（默认半透明托盘，皮肤激活后被覆盖）
             - SkinIsActive：是否处于皮肤模式（默认 false）
             - SkinDarkenOpacity：皮肤暗化强度（默认 0）
             - SkinAccentFromSkin：当前主色（默认系统蓝） -->
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" Opacity="0.31" />
        <x:Null x:Key="CardShadowEffect" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1F1F22" />
        <SolidColorBrush x:Key="SkinBackgroundBrush" Color="#1F1F22" />
        <sys:Boolean x:Key="SkinIsActive">False</sys:Boolean>
        <sys:Double x:Key="SkinDarkenOpacity">0</sys:Double>
        <SolidColorBrush x:Key="SkinAccentFromSkin" Color="#FF0A84FF" />

        <!-- 设置中心分组卡片表面令牌：由 SettingsUi 用 SetResourceReference 动态引用（一处改、所有分区卡片
             自动跟随）。半透明白叠加而非实色，保留毛玻璃通透感，不遮挡底层材质。 -->
        <SolidColorBrush x:Key="SettingsCardBackground" Color="#FFFFFF" Opacity="0.055" />
        <SolidColorBrush x:Key="SettingsCardBorder" Color="#FFFFFF" Opacity="0.10" />

        <!-- 开关开启色：macOS 系统绿。收口为令牌，便于主题/皮肤后续统一替换（当前保持 macOS 观感）。 -->
        <SolidColorBrush x:Key="ToggleOnBrush" Color="#FF34C759" />

        <!-- 语义状态色三档（macOS 系统色板）：成功/警告/危险。界面内一切绿/橙/红语义
             （电量档位、暂停提示、确认反馈、勾选态）一律引用这三档，禁止各弹窗自配色。 -->
        <SolidColorBrush x:Key="StatusSuccess" Color="#FF34C759" />
        <SolidColorBrush x:Key="StatusWarning" Color="#FFFF9F0A" />
        <SolidColorBrush x:Key="StatusDanger" Color="#FFFF5F57" />

        <!-- macOS 风开关（Toggle）
             视觉要点：①开启色走 ToggleOnBrush 令牌；②旋钮用 RenderTransform 补间 180ms 滑动
             ——刻意不动画 Margin/Alignment，避免每帧触发布局；③键盘聚焦显示强调色焦点环
             （可达性：状态不靠 hover 单独表达）。 -->
        <Style x:Key="MacToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                            <Grid Grid.Column="0" Width="40" Height="23"
                                  VerticalAlignment="Center" HorizontalAlignment="Right">
                                <!-- 焦点环：仅键盘聚焦可见，外扩 3px 不挤压布局 -->
                                <Border x:Name="focusRing" Margin="-3" CornerRadius="13.5"
                                        BorderBrush="{DynamicResource SkinAccentFromSkin}"
                                        BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="track" CornerRadius="11.5"
                                        Background="{DynamicResource ControlTrack}">
                                    <Ellipse x:Name="knob" Width="19" Height="19" Fill="White"
                                             Margin="2,0,0,0" HorizontalAlignment="Left"
                                             VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <TranslateTransform X="0" Y="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource ToggleOnBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob"
                                                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             To="17" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob"
                                                             Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风下拉框 -->
        <Style x:Key="MacCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- 下拉项前景色：默认 ComboBoxItem 文字为系统黑，在深色弹层上看不清，这里统一提亮 -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5,8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PopupItemHover}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" SnapsToDevicePixels="True" />
                            <ToggleButton x:Name="Toggle" Background="Transparent"
                                          BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <!-- 关键：选中框（常态收起时显示的内容）必须显式绑前景色到控件自身 Foreground。
                                         否则选中 string 项时 WPF 在 SelectionBoxItem 外包一层容器，前景继承链在深色主题下断开 → 回退系统默认黑字。
                                         下拉打开后项已用 ItemsPresenter 亮色解决；此处补上常态选中框的亮色。 -->
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Margin="10,0,26,0" VerticalAlignment="Center" />
                                    <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ControlForeground}" StrokeThickness="1.4"
                                          Opacity="0.6"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False">
                                <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
                                        BorderThickness="1" CornerRadius="7" Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <!-- 关键修复：下拉项宿主必须是 ItemsPresenter（或带 ItemsPanelTemplate 的容器），
                                         裸 StackPanel+IsItemsHost 与 ComboBox 模板期望冲突，会导致项"能选但不渲染/不显示"。
                                         在 ItemsPresenter 上直接设前景色，保证下拉选项文字（含纯字符串项）一律亮色，
                                         不依赖 ComboBoxItem 默认模板对 ItemContainerStyle 的继承（自定义 ControlTemplate 下偶有失效）。 -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter
                                            TextElement.Foreground="{DynamicResource ControlForeground}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风按钮（视觉结果与改造前一致，仅叠加键盘焦点环） -->
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    CornerRadius="7" SnapsToDevicePixels="True" />
                            <Border x:Name="focusRing" CornerRadius="7" Margin="-2"
                                    BorderBrush="{DynamicResource SkinAccentFromSkin}"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调按钮：底色取强调色令牌 SkinAccentFromSkin（默认 #FF0A84FF，与改造前同色），
             使皮肤/主题切换时自动跟随。hover/press 改用叠加遮罩而非换底色——
             这样任意强调色都能派生出一致的明暗反馈，不必为每种颜色手写一组色值。 -->
        <Style x:Key="MacAccentButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="{DynamicResource SkinAccentFromSkin}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    CornerRadius="7" SnapsToDevicePixels="True" />
                            <Border x:Name="shade" CornerRadius="7" Background="White" Opacity="0"
                                    IsHitTestVisible="False" />
                            <Border x:Name="focusRing" CornerRadius="7" Margin="-2"
                                    BorderBrush="{DynamicResource SkinAccentFromSkin}"
                                    BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="shade" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="shade" Property="Background" Value="Black" />
                                <Setter TargetName="shade" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focusRing" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风滑块（亮色轨道 + 亮色 thumb，避免系统默认黑）
             补充：已填充区间（轨道左侧到 thumb）用强调色表达，解决此前"只有一根轨道、看不出当前值占比"。
             实现取 Track 的 DecreaseRepeatButton 槽位——它天然占据"起点→thumb"区间，无需转换器；
             并设 IsHitTestVisible=False / Focusable=False，保持"只有 thumb 可拖动"的既有交互不变。 -->
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Height="4" CornerRadius="2"
                                    Background="{DynamicResource ControlTrack}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- 右侧 -7px 让填充延伸到 thumb 中心，接缝无断口 -->
                                                <Border Height="4" CornerRadius="2" Margin="0,0,-7,0"
                                                        Background="{DynamicResource SkinAccentFromSkin}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse x:Name="dot"
                                                             Fill="{DynamicResource ControlForeground}"
                                                             Stroke="{DynamicResource SkinAccentFromSkin}"
                                                             StrokeThickness="1.5"
                                                             RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="dot" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.16" ScaleY="1.16" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="dot" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             全局视觉规范（统一收口：新界面自动沿用，无需逐个提醒）
             滚动条 / 描边 / 阴影 三类。所有颜色跟随毛玻璃中性协调色，
             文字恒亮、不实现深/浅色。
             ============================================================ -->

        <!-- ===== 1. 描边三档（BorderBrush 资源，直接套用到 Border.BorderBrush） ===== -->
        <!-- 主卡片描边：最常用，1px 半透明白，克制清晰 -->
        <SolidColorBrush x:Key="BorderStroke" Color="#FFFFFF" Opacity="0.14" />
        <!-- 次级描边：更弱，用于内部分隔/次要容器 -->
        <SolidColorBrush x:Key="BorderStrokeSubtle" Color="#FFFFFF" Opacity="0.08" />
        <!-- 强调描边：系统蓝，用于选中/聚焦/重点元素 -->
        <SolidColorBrush x:Key="BorderStrokeAccent" Color="#FF0A84FF" Opacity="0.9" />

        <!-- ===== 2. 阴影四档（DropShadowEffect 资源，套用到 UIElement.Effect） ===== -->
        <!-- 无阴影（默认，扁平毛玻璃风格） -->
        <DropShadowEffect x:Key="ShadowNone" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000" />
        <!-- 轻微：卡片轻悬浮，几乎贴合 -->
        <DropShadowEffect x:Key="ShadowSm" BlurRadius="6" ShadowDepth="1" Opacity="0.28" Color="#000000" />
        <!-- 中等：常规浮起，弹层/下拉常用 -->
        <DropShadowEffect x:Key="ShadowMd" BlurRadius="14" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        <!-- 强：明显层次，模态/重点窗口 -->
        <DropShadowEffect x:Key="ShadowLg" BlurRadius="26" ShadowDepth="6" Opacity="0.42" Color="#000000" />

        <!-- ===== 3. 全局滚动条（macOS 风：细窄、深色轨道、圆角亮色 thumb） ===== -->
        <!-- 3a. 带 Key 的显式样式（供需要显式引用的 ScrollViewer 使用） -->
        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                       Orientation="Vertical" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3b. 通用滚动条外观（被垂直/水平滚动条 BasedOn） -->
        <Style x:Key="MacScrollBarBase" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="0,2,0,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 垂直滚动条（带 Key 显式引用用） -->
        <Style x:Key="MacScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Width="6" HorizontalAlignment="Center"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 水平滚动条（带 Key 显式引用用） -->
        <Style x:Key="MacScrollBarH" TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Height="6" VerticalAlignment="Center"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3c. 无 Key 全局默认（唯一）：所有 ScrollBar 自动套用（含 ListBox/ScrollViewer 内嵌），
             无需逐个引用，新界面零配置沿用。按 Orientation 切换垂直/水平 thumb 方向。 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 默认按垂直（窄宽条 6px）；水平时由下方 DataTrigger 改为矮高条 -->
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Width="6" Height="Auto"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                                <!-- 水平滚动条：thumb 改为横向细长条 -->
                                                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="Auto" />
                                                    <Setter TargetName="ThumbBorder" Property="Height" Value="6" />
                                                    <Setter TargetName="ThumbBorder" Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter TargetName="ThumbBorder" Property="VerticalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <!-- 水平滚动条：Track 不反向（值从左到右递增） -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
