<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BetterDesktop 启动器（2026-09-18）——**一次性**入口程序（出货名 BetterDesktop.exe）。

    【它解决什么】此前"启动 BetterDesktop"没有单一入口：
      · 双击 Host.exe → 走 Bootstrap 只管壳自己（托盘/Agent/看门狗靠自启或用户手动）；
      · 双击 Tray.exe → 有托盘但壳不一定起来；
      · 装完第一次运行由安装脚本代劳，之后用户就"不知道点哪个"。
    真机反复反馈的三件事（"没把其他程序一并拉起" / "功能不可用" / "托盘不在"）本质都是同一个缺口。
    本程序把"拉起全部 + 保证可用 + 让用户表达偏好"收成一次点击：**跑完即退，绝不常驻**。

    【为什么引用 kernel + shell-core（而不是零引用）】
      · Kernel：DeploymentInfo（当前安装根 = deployment.json 单一真相），避免再复刻一份查找链；
      · Shell.Core：DesktopControlLocator（桌面服务三级定位链，仓库已有单一实现，禁止复制）。
    其余能力一律走既有**跨进程契约**（CLI / 管道 / 设置文件），不在本进程内复制业务逻辑。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>BetterDesktop.Launcher</RootNamespace>
    <!-- 出货名就是用户双击的那个 BetterDesktop.exe（全仓无同名引用，已核）。 -->
    <AssemblyName>BetterDesktop</AssemblyName>
    <ApplicationIcon>..\host\Assets\BetterDesktop.ico</ApplicationIcon>
    <!-- 与 Host 同款构建戳：版本号能自证"这一份是哪次构建"，便于与版本问题对账。 -->
    <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy.MM.dd.HHmm'))</BuildStamp>
    <FileVersion>$(BuildStamp)</FileVersion>
    <InformationalVersion>1.3.0-$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BetterDesktop.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\kernel\kernel\BetterDesktop.Kernel.csproj" />
    <ProjectReference Include="..\..\shell\shell-core\BetterDesktop.Shell.Core.csproj" />
  </ItemGroup>

</Project>
