<!--
  BetterDesktop 启动器的应用资源。

  【刻意不合并 ShellTheme.xaml】那个字典里的控件样式由代码侧 helper 按 tokens 生成
  （见 shell-settings 的 WithStyle("MacToggle", tokens)），外部工程按名字直接引用并不稳。
  启动器只有一屏控件，自带样式反而更可控（也不给"启动失败"多留一个可能）。
  窗口实现见 LauncherWindow.xaml。
-->
<Application x:Class="BetterDesktop.Launcher.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 配色：与产品其它窗口一致的冷灰底 + 蓝色强调（不依赖外部字典，避免加载期未知资源键）。 -->
            <SolidColorBrush x:Key="LauncherBackground" Color="#FF1B1D21" />
            <SolidColorBrush x:Key="LauncherCard" Color="#FF24272C" />
            <SolidColorBrush x:Key="LauncherBorder" Color="#FF33373D" />
            <SolidColorBrush x:Key="LauncherText" Color="#FFECEFF3" />
            <SolidColorBrush x:Key="LauncherTextDim" Color="#FF9AA3AE" />
            <SolidColorBrush x:Key="LauncherAccent" Color="#FF3B82F6" />
            <SolidColorBrush x:Key="LauncherOk" Color="#FF3FBF7F" />
            <SolidColorBrush x:Key="LauncherWarn" Color="#FFE0A33E" />
            <SolidColorBrush x:Key="LauncherFail" Color="#FFE0574C" />

            <Style x:Key="LauncherToggle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource LauncherText}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="LauncherPrimaryButton" TargetType="Button">
                <Setter Property="Padding" Value="18,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource LauncherAccent}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="LauncherGhostButton" TargetType="Button">
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource LauncherText}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{StaticResource LauncherBorder}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
