<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BetterDesktop.Updater —— 独立更新器（对齐"草特码工具"的 Renewal.exe：独立进程、按需拉起）。

    设计约束：
    1) 零包引用（只用 BCL）：更新器必须在主程序损坏/缺失时仍能工作；也避免把 WPF 拖进来。
       （统一日志因此以 shared/logging 共享源方式编译，而非项目引用。）
    2) 不覆写正在运行的 exe：Windows 不允许，采用"改名旧的 → 落新的 → 重启后清理"。
    3) 失败必须显式失败 + 可回滚：任何异常都先还原备份再返回非零退出码（禁止"静默半更新"）。
    4) 与控制面（Tray）解耦：结果写 %LOCALAPPDATA%\BetterDesktop\update-status.json，
       托盘读该文件弹气泡，不需要进程间协议。

    退出码（对外契约，Tray/脚本依赖）：
      0  已是最新        10 有可用更新      11 下载校验完成
      12 替换完成并已重启 13 回滚完成
      2  参数错误        3  更新源不可达    4  清单无效/校验失败   5  应用失败（已回滚）
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>BetterDesktop.Updater</RootNamespace>
    <AssemblyName>BetterDesktop.Updater</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <BuildStamp>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm"))</BuildStamp>
    <FileVersion>$(BuildStamp)</FileVersion>
    <InformationalVersion>1.3.0-$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 跨进程统一日志：共享源（见 packages/kernel/kernel 中同一份文件的说明）。 -->
    <Compile Include="..\shared\logging\*.cs" LinkBase="Logging" />
  </ItemGroup>

</Project>
