<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Platforms>x64</Platforms>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BetterDesktop.Host</RootNamespace>
    <AssemblyName>BetterDesktop.Host</AssemblyName>
    <!-- 品牌图标:exe 文件图标(资源管理器/任务栏/Alt-Tab) -->
    <ApplicationIcon>Assets\BetterDesktop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 品牌资源(嵌入程序集,pack URI 访问):应用图标 + 初始化弹窗动画 -->
    <Resource Include="Assets\BetterDesktop.ico" />
    <Resource Include="Assets\splash-anim-v5.mp4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 声明式插件树配置：LoaderService 运行时读取，输出目录保留最新 -->
    <Content Include="cordis.yml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 主程序构建版本时间戳：每次编译以当前 UTC 时间自动生成（yyyy.MM.dd.HHmm），
         落入 文件版本 FileVersion 与 信息版本 InformationalVersion 后缀，保证"编译版本"始终新鲜；
         AssemblyVersion 由 Directory.Build.props 统一为 1.3.0.0（稳定），避免运行时引用绑定随每次构建漂移。 -->
    <BuildStamp>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm"))</BuildStamp>
    <FileVersion>$(BuildStamp)</FileVersion>
    <!-- 产品版本统一 1.3.0（Directory.Build.props），后缀编译时间戳保证构建新鲜度 -->
    <InformationalVersion>1.3.0-$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\packages\kernel\kernel\BetterDesktop.Kernel.csproj" />
    <ProjectReference Include="..\packages\kernel\kernel-hmr\BetterDesktop.Kernel.Hmr.csproj" />
    <ProjectReference Include="..\packages\kernel\kernel-loader\BetterDesktop.Kernel.Loader.csproj" />
    <ProjectReference Include="..\packages\kernel\kernel-timer\BetterDesktop.Kernel.Timer.csproj" />
    <ProjectReference Include="..\packages\shell\shell-core\BetterDesktop.Shell.Core.csproj" />
    <ProjectReference Include="..\packages\shell\shell-dock\BetterDesktop.Shell.Dock.csproj" />
    <ProjectReference Include="..\packages\shell\shell-notification\BetterDesktop.Shell.Notification.csproj" />
    <ProjectReference Include="..\packages\shell\shell-recent\BetterDesktop.Shell.Recent.csproj" />
    <ProjectReference Include="..\packages\shell\shell-search\BetterDesktop.Shell.Search.csproj" />
    <ProjectReference Include="..\packages\shell\shell-settings\BetterDesktop.Shell.Settings.csproj" />
    <ProjectReference Include="..\packages\shell\shell-status\BetterDesktop.Shell.Status.csproj" />
    <ProjectReference Include="..\packages\shell\shell-menu-bar\BetterDesktop.Shell.MenuBar.csproj" />
    <ProjectReference Include="..\packages\shell\shell-quick-note\BetterDesktop.Shell.QuickNote.csproj" />
    <ProjectReference Include="..\packages\shell\shell-clipboard\BetterDesktop.Shell.Clipboard.csproj" />
    <ProjectReference Include="..\packages\shell\shell-app-source\BetterDesktop.Shell.AppSource.csproj" />
    <ProjectReference Include="..\packages\shell\shell-window-tracker\BetterDesktop.Shell.WindowTracker.csproj" />
    <ProjectReference Include="..\packages\shell\shell-pinning\BetterDesktop.Shell.Pinning.csproj" />
    <ProjectReference Include="..\packages\shell\shell-calendar\BetterDesktop.Shell.Calendar.csproj" />
    <ProjectReference Include="..\packages\shell\shell-taskbar\BetterDesktop.Shell.Taskbar.csproj" />
    <ProjectReference Include="..\packages\shell\shell-start-menu\BetterDesktop.Shell.StartMenu.csproj" />
    <ProjectReference Include="..\packages\shell\shell-desktop\BetterDesktop.Shell.Desktop.csproj" />
    <ProjectReference Include="..\packages\shell\shell-context-menu\BetterDesktop.Shell.ContextMenu.csproj" />
    <ProjectReference Include="..\packages\shell\shell-convert\BetterDesktop.Shell.Convert.csproj" />
  </ItemGroup>

</Project>