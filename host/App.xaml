<Application x:Class="BetterDesktop.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <!-- 外观模式驱动的控件画刷（由 AppearanceService 在模式切换时实时写入 Application.Current.Resources）。
             macOS 风控件（Mac* 样式）一律引用这些 DynamicResource，使亮色/暗色/无色模式一键切换。 -->
        <SolidColorBrush x:Key="ControlForeground" Color="#FFECECEC" />
        <SolidColorBrush x:Key="ControlBackground" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="ControlBackgroundHover" Color="#FF48484A" />
        <SolidColorBrush x:Key="ControlBackgroundPressed" Color="#FF343436" />
        <SolidColorBrush x:Key="ControlBorder" Color="#FF48484A" />
        <SolidColorBrush x:Key="ControlTrack" Color="#FF48484A" />
        <SolidColorBrush x:Key="PopupBackground" Color="#FF2C2C2E" />
        <SolidColorBrush x:Key="PopupBorder" Color="#FF48484A" />
        <SolidColorBrush x:Key="PopupItemHover" Color="#FF3A3A3C" />

        <!-- 主题令牌画笔（由 AppearanceService 按外观模式实时推送，供 XAML DynamicResource 引用）。
             使设置窗口等 XAML 直接绑定令牌、随模式一键切换，无需在代码里手写补色（消除"特例独行"）。 -->
        <SolidColorBrush x:Key="ThemeWindowBackground" Color="#1F1F22" />
        <SolidColorBrush x:Key="ThemePanelBackground" Color="#262629" />
        <SolidColorBrush x:Key="ThemeContentBackground" Color="#2A2A2E" />
        <SolidColorBrush x:Key="ThemeForeground" Color="#F2F2F2" />
        <SolidColorBrush x:Key="ThemeMutedForeground" Color="#C4C4C4" />
        <SolidColorBrush x:Key="ThemeSeparator" Color="#B0B0B0" Opacity="0.25" />

        <!-- 皮肤/描边扩散令牌初始兜底：AppearanceService 在 Initialize() 时会以相同键覆盖推送，
             此处仅作 XAML 解析期兜底，防止 Initialize 时序异常导致 DynamicResource 键缺失而黑屏崩溃。
             - CardBorderBrush：窗口根描边（随主题刷新；默认中性半透明白，对齐 dock 描边基准）
             - CardShadowEffect：卡片外边缘阴影（默认 null = 无阴影，与当前"暂停外投影"一致）
             - BackgroundBrush / SkinBackgroundBrush：窗口根背景画刷（默认半透明托盘，皮肤激活后被覆盖）
             - SkinIsActive：是否处于皮肤模式（默认 false）
             - SkinDarkenOpacity：皮肤暗化强度（默认 0）
             - SkinAccentFromSkin：当前主色（默认系统蓝） -->
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFFFFF" Opacity="0.31" />
        <x:Null x:Key="CardShadowEffect" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1F1F22" />
        <SolidColorBrush x:Key="SkinBackgroundBrush" Color="#1F1F22" />
        <sys:Boolean x:Key="SkinIsActive">False</sys:Boolean>
        <sys:Double x:Key="SkinDarkenOpacity">0</sys:Double>
        <SolidColorBrush x:Key="SkinAccentFromSkin" Color="#FF0A84FF" />

        <!-- macOS 风开关（Toggle） -->
        <Style x:Key="MacToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                            <Border x:Name="track" Grid.Column="0" Width="40" Height="23"
                                    CornerRadius="11.5" Background="{DynamicResource ControlTrack}"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Ellipse x:Name="knob" Width="19" Height="19" Fill="White"
                                         Margin="2,0,0,0" HorizontalAlignment="Left"
                                         VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#FF34C759" />
                                <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风下拉框 -->
        <Style x:Key="MacCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- 下拉项前景色：默认 ComboBoxItem 文字为系统黑，在深色弹层上看不清，这里统一提亮 -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5,8,5" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PopupItemHover}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7" SnapsToDevicePixels="True" />
                            <ToggleButton x:Name="Toggle" Background="Transparent"
                                          BorderThickness="0" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Grid>
                                    <!-- 关键：选中框（常态收起时显示的内容）必须显式绑前景色到控件自身 Foreground。
                                         否则选中 string 项时 WPF 在 SelectionBoxItem 外包一层容器，前景继承链在深色主题下断开 → 回退系统默认黑字。
                                         下拉打开后项已用 ItemsPresenter 亮色解决；此处补上常态选中框的亮色。 -->
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Margin="10,0,26,0" VerticalAlignment="Center" />
                                    <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ControlForeground}" StrokeThickness="1.4"
                                          Opacity="0.6"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,10,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False">
                                <Border Background="{DynamicResource PopupBackground}" BorderBrush="{DynamicResource PopupBorder}"
                                        BorderThickness="1" CornerRadius="7" Padding="2"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <!-- 关键修复：下拉项宿主必须是 ItemsPresenter（或带 ItemsPanelTemplate 的容器），
                                         裸 StackPanel+IsItemsHost 与 ComboBox 模板期望冲突，会导致项"能选但不渲染/不显示"。
                                         在 ItemsPresenter 上直接设前景色，保证下拉选项文字（含纯字符串项）一律亮色，
                                         不依赖 ComboBoxItem 默认模板对 ItemContainerStyle 的继承（自定义 ControlTemplate 下偶有失效）。 -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter
                                            TextElement.Foreground="{DynamicResource ControlForeground}" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ControlBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风按钮 -->
        <Style x:Key="MacButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlBackgroundPressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调蓝按钮（清晰系统蓝，在深色毛玻璃上对比明确） -->
        <Style x:Key="MacAccentButton" TargetType="Button" BasedOn="{StaticResource MacButton}">
            <Setter Property="Background" Value="#FF0A84FF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                CornerRadius="7" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF3B9BFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF0A6FD6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS 风滑块（亮色轨道 + 亮色 thumb，避免系统默认黑） -->
        <Style x:Key="MacSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource ControlForeground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="IsSnapToTickEnabled" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border x:Name="Track" Height="4" CornerRadius="2"
                                    Background="{DynamicResource ControlTrack}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource ControlForeground}" Stroke="#FF0A84FF" StrokeThickness="1.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             全局视觉规范（统一收口：新界面自动沿用，无需逐个提醒）
             滚动条 / 描边 / 阴影 三类。所有颜色跟随毛玻璃中性协调色，
             文字恒亮、不实现深/浅色。
             ============================================================ -->

        <!-- ===== 1. 描边三档（BorderBrush 资源，直接套用到 Border.BorderBrush） ===== -->
        <!-- 主卡片描边：最常用，1px 半透明白，克制清晰 -->
        <SolidColorBrush x:Key="BorderStroke" Color="#FFFFFF" Opacity="0.14" />
        <!-- 次级描边：更弱，用于内部分隔/次要容器 -->
        <SolidColorBrush x:Key="BorderStrokeSubtle" Color="#FFFFFF" Opacity="0.08" />
        <!-- 强调描边：系统蓝，用于选中/聚焦/重点元素 -->
        <SolidColorBrush x:Key="BorderStrokeAccent" Color="#FF0A84FF" Opacity="0.9" />

        <!-- ===== 2. 阴影四档（DropShadowEffect 资源，套用到 UIElement.Effect） ===== -->
        <!-- 无阴影（默认，扁平毛玻璃风格） -->
        <DropShadowEffect x:Key="ShadowNone" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000" />
        <!-- 轻微：卡片轻悬浮，几乎贴合 -->
        <DropShadowEffect x:Key="ShadowSm" BlurRadius="6" ShadowDepth="1" Opacity="0.28" Color="#000000" />
        <!-- 中等：常规浮起，弹层/下拉常用 -->
        <DropShadowEffect x:Key="ShadowMd" BlurRadius="14" ShadowDepth="3" Opacity="0.34" Color="#000000" />
        <!-- 强：明显层次，模态/重点窗口 -->
        <DropShadowEffect x:Key="ShadowLg" BlurRadius="26" ShadowDepth="6" Opacity="0.42" Color="#000000" />

        <!-- ===== 3. 全局滚动条（macOS 风：细窄、深色轨道、圆角亮色 thumb） ===== -->
        <!-- 3a. 带 Key 的显式样式（供需要显式引用的 ScrollViewer 使用） -->
        <Style x:Key="MacScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                       Orientation="Vertical" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal" Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3b. 通用滚动条外观（被垂直/水平滚动条 BasedOn） -->
        <Style x:Key="MacScrollBarBase" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="0,2,0,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 垂直滚动条（带 Key 显式引用用） -->
        <Style x:Key="MacScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Width="6" HorizontalAlignment="Center"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 水平滚动条（带 Key 显式引用用） -->
        <Style x:Key="MacScrollBarH" TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Height="6" VerticalAlignment="Center"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3c. 无 Key 全局默认（唯一）：所有 ScrollBar 自动套用（含 ListBox/ScrollViewer 内嵌），
             无需逐个引用，新界面零配置沿用。按 Orientation 切换垂直/水平 thumb 方向。 -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MacScrollBarBase}">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}"
                               Value="{TemplateBinding Value}" Margin="2,2,2,2">
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 默认按垂直（窄宽条 6px）；水平时由下方 DataTrigger 改为矮高条 -->
                                            <Border x:Name="ThumbBorder" Background="#FF6A6A6E"
                                                    CornerRadius="5" Width="6" Height="Auto"
                                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                                    SnapsToDevicePixels="True" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FF8A8A8E" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#FFA0A0A4" />
                                                </Trigger>
                                                <!-- 水平滚动条：thumb 改为横向细长条 -->
                                                <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
                                                    <Setter TargetName="ThumbBorder" Property="Width" Value="Auto" />
                                                    <Setter TargetName="ThumbBorder" Property="Height" Value="6" />
                                                    <Setter TargetName="ThumbBorder" Property="HorizontalAlignment" Value="Stretch" />
                                                    <Setter TargetName="ThumbBorder" Property="VerticalAlignment" Value="Center" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <ControlTemplate.Triggers>
                            <!-- 水平滚动条：Track 不反向（值从左到右递增） -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Track.IsDirectionReversed" Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
