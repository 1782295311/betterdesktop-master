<Window x:Class="BetterDesktop.Tools.ShellComponentsPlayground.PlaygroundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation/shell"
        Title="BetterDesktop · 组件验证工作台"
        Height="860" Width="1500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#FF1C1C1E">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      CornerRadius="10"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="#FF1C1C1E" CornerRadius="10" x:Name="Chrome">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自绘标题栏：Mica Alt 暗色 + 左侧 Logo + 标题 + 右自定义控制按钮 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="#FF202024" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="14" Height="14" CornerRadius="4" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF5B9BFF" Offset="0"/>
                                <GradientStop Color="#FF8B6BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Foreground="#FFE5E5EA" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center">BetterDesktop</TextBlock>
                    <Border Background="#3A3A3E" CornerRadius="3" Padding="7,2" Margin="12,0,0,0">
                        <TextBlock Foreground="#FFC0C0C5" FontSize="10" FontWeight="SemiBold"
                                   Text="组件验证工作台 · 未接入主项目"/>
                    </Border>
                    <TextBlock Foreground="#FF8A8A90" FontSize="11" VerticalAlignment="Center"
                               Margin="14,0,0,0">
                        所有内容来自系统实时采集 / 系统输入法枚举 / 系统时钟 / 农历算法，零硬编码假数据
                    </TextBlock>
                </StackPanel>

                <!-- 自定义控制按钮（模仿 Win11：最小化 / 最大化 / 关闭） -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnMin" Content="&#xE921;" Width="46" Height="40"
                            FontFamily="Segoe UI Symbol" Background="Transparent" Foreground="#FFC0C0C5"
                            BorderThickness="0" FontSize="10" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMinimizeClick" />
                    <Button x:Name="BtnMax" Content="&#xE922;" Width="46" Height="40"
                            FontFamily="Segoe UI Symbol" Background="Transparent" Foreground="#FFC0C0C5"
                            BorderThickness="0" FontSize="10" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnMaximizeClick" />
                    <Button x:Name="BtnClose" Content="&#xE8BB;" Width="46" Height="40"
                            FontFamily="Segoe UI Symbol" Background="Transparent" Foreground="#FFC0C0C5"
                            BorderThickness="0" FontSize="11" WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 主体：左侧导航 + 右侧滚动内容 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航 -->
                <Border Grid.Column="0" Background="#FF1E1E22">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="10,14">
                        <StackPanel>
                            <TextBlock Foreground="#FF8A8A90" FontSize="10"
                                       FontWeight="SemiBold" Margin="6,4,0,10">工作台</TextBlock>

                            <!-- 导航项 -->
                            <Border x:Name="NavOverview" CornerRadius="6" Background="#3A5DFF2A"
                                    Padding="10,8" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D4;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF7AA7FF" VerticalAlignment="Center"/>
                                    <TextBlock Text="总览（全部）" Foreground="#FFE5E5EA" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Foreground="#FF8A8A90" FontSize="10"
                                       FontWeight="SemiBold" Margin="6,14,0,8">核心独立面板（8 个）</TextBlock>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F1;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="① IME 输入法切换" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="② 日历 / 农历" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="③ 控制中心（收纳式）" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE700;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="④ 蓝牙（设备列表）" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE814;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑤ Wi‑Fi（连接 &amp; 附近）" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE771;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑥ 主题（深色/浅色）" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE83F;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑦ 电池 &amp; 性能模式" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Foreground="#FF8A8A90" FontSize="10"
                                       FontWeight="SemiBold" Margin="6,14,0,8">真实功能面板（5 个）</TextBlock>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AF;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑨ NETWORK" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B9;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑩ MEM" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC0B;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑪ CPU" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE720;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑫ 麦克风" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe UI Symbol"
                                               FontSize="14" Foreground="#FF9A9AA0" VerticalAlignment="Center"/>
                                    <TextBlock Text="⑬ 声音" Foreground="#FFC0C0C5" FontSize="12"
                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" Background="#3A3A3E" Width="1" HorizontalAlignment="Stretch" />

                <!-- 右侧滚动内容区：Hero · 核心独立面板 · 系统状态详情 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="24,20,24,24">
                        <StackPanel>

                            <!-- Section A: Hero 说明卡 + 顶部菜单栏预览 -->
                            <Border CornerRadius="12"
                                    Padding="18,16,18,16" Margin="0,0,0,18">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF2A3A66" Offset="0"/>
                                        <GradientStop Color="#FF382261" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Foreground="#FFE6EAF5" FontSize="16"
                                                       FontWeight="SemiBold">
                                                Shell 组件独立验证工作台
                                            </TextBlock>
                                            <TextBlock Foreground="#FFB5BFD5" FontSize="12"
                                                       Margin="0,4,0,0">
                                                下方同时铺出菜单栏、核心独立面板与真实功能面板。
                                                全部 UI 来自系统真值，无任何硬编码假数据。通过后再分步接入主项目。
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Background="#24FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Foreground="White" FontSize="10">
                                                    shell.status · 6 项监控已加载
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#24FFFFFF" CornerRadius="4" Padding="8,4">
                                                <TextBlock Foreground="White" FontSize="10">
                                                    shell.menu-bar · 7 独立面板就绪
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 顶部菜单栏预览（内嵌在 Hero 卡内） -->
                                    <Border CornerRadius="8" Background="#1EFFFFFF" Padding="10,8"
                                            Margin="0,14,0,0" x:Name="MenuBarHostWrapper">
                                        <Grid x:Name="MenuBarHost"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Section B: 核心独立面板（三列并排） -->
                            <TextBlock Foreground="#FFD0D0D5" FontSize="13"
                                       FontWeight="SemiBold" Margin="2,0,0,10">
                                核心独立面板（主项目中，各自为独立 ShellWindow，由菜单栏按钮触发）
                            </TextBlock>
                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ① IME 输入法切换
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2D4CE69A">
                                                <TextBlock Foreground="#FF4CE69A" FontSize="10" FontWeight="SemiBold"
                                                           Text="系统输入法枚举"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="ImeHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ② 日历 / 农历
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2D59B7FF">
                                                <TextBlock Foreground="#FF59B7FF" FontSize="10" FontWeight="SemiBold"
                                                           Text="系统时钟 + 农历算法"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="CalendarHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ③ 控制中心（收纳式）
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2DF7BA3A">
                                                <TextBlock Foreground="#FFF7BA3A" FontSize="10" FontWeight="SemiBold"
                                                           Text="多状态汇总"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="ControlCenterHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Section C: 已删除。系统状态详情已有独立面板（⑧-⑫），不再重复展示状态卡。 -->

                            <!-- Section D: 5 个新独立面板（蓝牙 / Wi-Fi / 主题 / 电池） -->
                            <TextBlock Foreground="#FFD0D0D5" FontSize="13"
                                       FontWeight="SemiBold" Margin="2,28,0,10">
                                新合并的独立面板（4 个，零硬编码 · 全部来自系统枚举）
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ④ 蓝牙设备
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2DFFB74D">
                                                <TextBlock Foreground="#FFFFB74D" FontSize="10" FontWeight="SemiBold"
                                                           Text="WinRT DeviceInformation"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="BluetoothHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ⑤ Wi‑Fi（连接 &amp; 附近）
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2D59B7FF">
                                                <TextBlock Foreground="#FF59B7FF" FontSize="10" FontWeight="SemiBold"
                                                           Text="wlanapi + NetworkInterface"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="WifiHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ⑥ 主题（深色/浅色）
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2D7B7BF0">
                                                <TextBlock Foreground="#FF7B7BF0" FontSize="10" FontWeight="SemiBold"
                                                           Text="注册表 Themes\Personalize"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="ThemeHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Foreground="#FFE5E5EA" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center">
                                                ⑦ 电池 &amp; 性能模式
                                            </TextBlock>
                                            <Border Grid.Column="1" CornerRadius="3" Padding="6,2"
                                                    Background="#2D4CE69A">
                                                <TextBlock Foreground="#FF4CE69A" FontSize="10" FontWeight="SemiBold"
                                                           Text="powrprof + PowerEnumerate"/>
                                            </Border>
                                        </Grid>
                                        <Border CornerRadius="8" Background="#FF1E1E22" Padding="8,6">
                                            <ContentControl x:Name="PowerHost"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 底部小间距 -->
                            <Border Height="20"/>

                            <!-- Section E: 用户新增 5 张独立详情面板（NETWORK / MEM / CPU / 麦克风 / 声音） -->
                            <TextBlock Foreground="#FFD0D0D5" FontSize="13"
                                       FontWeight="SemiBold" Margin="2,8,0,10">
                                真实功能试验 · 5 张新面板（C++ Native DLL 封装 + C# 薄封装，零硬编码假数据）
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Column="0" Grid.Row="0" CornerRadius="12" Padding="14,12"
                                        Background="#FF262629" BorderBrush="#3A3A3E" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
