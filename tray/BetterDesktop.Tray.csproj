<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BetterDesktop.Tray —— 常驻系统托盘组件（对齐"草特码工具"的形态：主程序=UI 壳，功能/托盘=独立组件）。

    设计约束（务必遵守，改动前先读）：
    1) 零包引用：只用 BCL + WinForms。不引用 kernel/shell 任何包 ——
       托盘的职责是"控制面 + 常驻"，不是功能实现；它必须能在主程序缺失/损坏时照常工作。
    2) 只依赖既有命令契约：所有功能开关都通过 BetterDesktop.Cli.exe 转发
       （CLI 内部自行路由：宿主在 → 命名管道热切；宿主不在 → 直写 settings.json）。
       禁止在托盘里重复实现设置读写/Ipc/管道客户端。
    3) 与主程序同一目录部署（见 docs/build-release.md：CLI/Host 必须同目录）。
    4) 托盘自身异常绝不允许拖垮常驻：所有菜单回调 try/catch + 写 tray-<date>.log。
  -->

  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>BetterDesktop.Tray</RootNamespace>
    <AssemblyName>BetterDesktop.Tray</AssemblyName>
    <!-- 品牌图标复用宿主同一份资源，避免出现两套 logo -->
    <ApplicationIcon>..\host\Assets\BetterDesktop.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 与 host 同款构建时间戳：FileVersion=编译时间，InformationalVersion=产品版本+时间戳（更新器识别"构建新鲜度"用） -->
    <BuildStamp>$([System.DateTime]::UtcNow.ToString("yyyy.MM.dd.HHmm"))</BuildStamp>
    <FileVersion>$(BuildStamp)</FileVersion>
    <InformationalVersion>1.3.0-$(BuildStamp)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 跨进程统一日志：共享源（见 packages/kernel/kernel 中同一份文件的说明）。 -->
    <Compile Include="..\shared\logging\*.cs" LinkBase="Logging" />
  </ItemGroup>

</Project>
